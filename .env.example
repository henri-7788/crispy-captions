# =============================================================================
#  Crispy Captions – Konfiguration
# =============================================================================
#
#  So geht's:
#    1. Diese Datei nach ".env" kopieren:   cp .env.example .env
#    2. Die Werte unten anpassen (mindestens OPENAI_API_KEY und JWT_SECRET).
#    3. Die ".env" niemals committen – sie enthält Geheimnisse.
#
#  Lokal (npm run dev) liest der Server die .env direkt ein.
#  Mit Docker liest docker compose die .env im Projektordner und reicht die
#  Werte an den Container weiter. In Portainer trägst du dieselben Variablen
#  stattdessen im Stack unter "Environment variables" ein.
#
#  Zeilen, die mit "#" beginnen, sind auskommentiert. Dann gilt der genannte
#  Standardwert. Zum Ändern das "#" entfernen und den Wert anpassen.
# =============================================================================


# -----------------------------------------------------------------------------
#  OpenAI (Pflicht)
# -----------------------------------------------------------------------------

# API-Schlüssel für die Transkription mit OpenAI Whisper.
# Erstellen unter: https://platform.openai.com/api-keys
# Jede Transkription kostet Guthaben auf diesem Account. Tipp: Im OpenAI-Account
# zusätzlich ein monatliches Ausgabelimit setzen.
OPENAI_API_KEY=sk-dein-schluessel-hier


# -----------------------------------------------------------------------------
#  Login & Sicherheit
# -----------------------------------------------------------------------------

# Geheimer Schlüssel, mit dem die Login-Tokens signiert werden. (Pflicht in Production)
# Muss lang und zufällig sein. Erzeugen mit:   openssl rand -hex 32
# Wer diesen Wert kennt, kann sich als beliebiger User ausgeben – also geheim halten.
# Wird er geändert, werden alle Benutzer ausgeloggt.
# Fehlt er in Production, startet der Server absichtlich nicht.
JWT_SECRET=hier-einen-langen-zufaelligen-string-eintragen

# Wie lange ein Login gültig bleibt, bevor man sich neu anmelden muss.
# Beispiele: 12h (12 Stunden), 7d (7 Tage), 30d (30 Tage). Standard: 7d
# JWT_EXPIRES_IN=7d


# -----------------------------------------------------------------------------
#  Erster Admin
# -----------------------------------------------------------------------------
#  Beim Start wird mit diesen Daten ein Admin-Account angelegt – aber NUR, wenn
#  es noch gar keinen Admin gibt. Ein bereits existierender Account mit dieser
#  E-Mail wird nie verändert.
#
#  Empfehlung: Nach dem ersten Login das Passwort im Admin-Bereich ändern und
#  ADMIN_PASSWORD danach wieder aus der Konfiguration entfernen.

# E-Mail-Adresse des ersten Admins (wird zum Einloggen verwendet).
ADMIN_EMAIL=admin@example.com

# Start-Passwort des ersten Admins. Ein sicheres Passwort wählen (mindestens 8 Zeichen).
ADMIN_PASSWORD=bitte-aendern


# -----------------------------------------------------------------------------
#  Limits (schützen Server und OpenAI-Guthaben)
# -----------------------------------------------------------------------------

# Wie viele Videos pro User in 24 Stunden transkribiert werden dürfen.
# Gezählt wird jeder Versuch, auch fehlgeschlagene. Admins sind ausgenommen.
# 0 = unbegrenzt. Standard: 30
# MAX_TRANSCRIPTIONS_PER_DAY=30

# Wie viele Videos gleichzeitig gerendert werden. Weitere warten in einer
# Warteschlange ("In Warteschlange..."). Gilt für Web-Oberfläche und API zusammen.
# Rendern ist CPU-lastig: Auf einem kleinen Server (z. B. 4 Kerne) 1–2 lassen.
# Standard: 2
# MAX_CONCURRENT_RENDERS=2

# Maximale Größe eines hochgeladenen Videos in Megabyte. Standard: 500
# MAX_FILE_SIZE_MB=500


# -----------------------------------------------------------------------------
#  Server
# -----------------------------------------------------------------------------

# Port, auf dem der Server läuft. Standard: 3001
# Hinweis Docker: Der Port nach außen wird in docker-compose.yml festgelegt.
PORT=3001

# Nur für die lokale Entwicklung: Adresse des Vite-Dev-Servers (Frontend), der
# auf das Backend zugreifen darf. In Production wird der Wert ignoriert, weil
# Frontend und Backend dann vom selben Server kommen.
CORS_ORIGIN=http://localhost:5173

# Ordner, in dem die Datenbank (User, Invite-Codes, Jobs) gespeichert wird.
# Standard: "data" im Projektordner. In Docker ist das /app/data – dort liegt
# ein Volume, damit die Daten einen Neustart oder ein Update überleben.
# DATA_DIR=./data

# Anzahl der Reverse-Proxies (z. B. nginx, Traefik, Cloudflare Tunnel) vor dem
# Server. Nötig, damit das Login-Rate-Limiting die echte IP der Besucher sieht.
# Sonst hätten alle Besucher dieselbe IP, und Fehlversuche einer Person
# könnten alle anderen am Login hindern.
#   - Server direkt im Internet, ohne Proxy:  weglassen
#   - Ein Proxy davor (typisch):               1
# Standard lokal: nicht gesetzt. Standard in docker-compose.yml: 1
# TRUST_PROXY=1
